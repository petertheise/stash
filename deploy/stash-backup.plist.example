<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly backup at 03:35. Replace /Users/YOU. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.example.stash-backup</string>
    <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/YOU/Stash/backup.sh</string></array>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>35</integer></dict>
    <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/stash-backup.log</string>
    <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/stash-backup.log</string>
</dict>
</plist>
